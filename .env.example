# Copie este archivo como .env y complete los valores (el .env nunca se sube al repositorio).

# Imagen publicada en Docker Hub
DOCKERHUB_USER=eduardo30458
APP_VERSION=1.0.0

# Credenciales de PostgreSQL (usadas por db y por app1/app2/app3)
DB_USER=
DB_PASSWORD=
DB_NAME=

# Habilita la cabecera X-Simular-Demora (solo para la prueba de timeout).
# Para retirar la simulación: PERMITIR_SIMULACION=false y luego `docker compose up -d`.
PERMITIR_SIMULACION=true
